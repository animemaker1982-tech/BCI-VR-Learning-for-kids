{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SigilMetadataPointerSchema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the Sigil Token"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol of the Sigil Token"
    },
    "description": {
      "type": "string",
      "description": "Description of the token pathway and sigil purpose"
    },
    "image": {
      "type": "string",
      "description": "URI or inline SVG data for the Sigil graphic asset"
    },
    "metadataPointer": {
      "type": "object",
      "properties": {
        "pointerAddress": {
          "type": "string",
          "description": "Smart contract or account address resolving this metadata"
        },
        "authority": {
          "type": "string",
          "description": "Address authorized to update or lock the metadata pointer"
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether the metadata pointer is permanently locked"
        }
      },
      "required": ["pointerAddress", "authority", "isLocked"]
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trait_type": { "type": "string" },
          "value": { "type": ["string", "number"] }
        },
        "required": ["trait_type", "value"]
      }
    }
  },
  "required": ["name", "symbol", "description", "image", "attributes"]
}
